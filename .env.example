# =============================================================================
# قلم | QALAM — Environment Variables (نموذج)
# انسخ هذا الملف إلى .env ثم املأ القيم. لا ترفع .env إلى GitHub أبدًا.
# =============================================================================

# -----------------------------------------------------------------------------
# 1) Supabase — متاح للمتصفح (VITE_ prefix = public)
#    من: Supabase Dashboard → Project Settings → API
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# 2) إعدادات التطبيق (اختيارية)
# -----------------------------------------------------------------------------
# مسار دوال Netlify (اتركه فارغًا للاستخدام الافتراضي /.netlify/functions)
VITE_FUNCTIONS_BASE=

# -----------------------------------------------------------------------------
# 3) أسرار الخادم فقط — تُضبط في Netlify → Site settings → Environment variables
#    ⚠️ لا تبدأ بـ VITE_ ولا تُحقن في المتصفح إطلاقًا.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
# اختياري: الموديل الافتراضي
OPENAI_MODEL=gpt-4o

# اختياري: سقف زمني لكل استدعاء خارجي بالملّي ثانية.
# الافتراضي 45000، ويُقصر تلقائيًا داخل المدى [5000, 120000].
AI_TIMEOUT_MS=45000

# اختياري: نموذج تحويل الصوت إلى نص (المساعد الصوتي)
WHISPER_MODEL=whisper-1

# نسخة server-side من عنوان Supabase ومفتاح anon (للتحقق من هوية المستخدم داخل الدالة)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ⚠️ Service Role Key: غير مطلوب. لا تستخدمه في المتصفح إطلاقًا.
# حد المعدّل وتتبّع الاستخدام يعملان برمز جلسة المستخدم نفسه ومفتاح anon،
# لا بمفتاح إداري — راجع docs/security.md.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# 4) اختبارات التكامل (تطوير فقط)
#    اتركه فارغًا: اختبارات قاعدة البيانات تُتخطى تلقائيًا بدونه.
#    راجع docs/testing.md لتجهيز قاعدة اختبار محلية.
# -----------------------------------------------------------------------------
QALAM_TEST_DATABASE_URL=
